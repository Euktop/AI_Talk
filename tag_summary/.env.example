# Пример переменных окружения для tag_summary.
# Скопируй в .env и заполни. .env добавлен в .gitignore.

# Путь к Obsidian-vault (переопределяет [vault] path из config.toml).
TAG_SUMMARY_VAULT=D:/Work/My_notes

